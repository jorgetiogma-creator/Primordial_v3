{
  "entities": {
    "PublicProfile": {
      "title": "PublicProfile",
      "description": "Public profile directory for registered Primordial users searchable by username",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID of the user" },
        "displayName": { "type": "string", "description": "Display name" },
        "username": { "type": "string", "description": "Unique handle without @" },
        "usernameLower": { "type": "string", "description": "Lowercase unique handle for search" },
        "avatar": { "type": "string", "description": "Preset avatar key" },
        "customAvatarUrl": { "type": "string", "description": "Optional avatar image URL" },
        "status": { "type": "string", "enum": ["online", "idle", "dnd", "offline"] },
        "customStatus": { "type": "string" },
        "bio": { "type": "string" },
        "bannerColor": { "type": "string" },
        "bannerImage": { "type": "string" },
        "decoration": { "type": "string" },
        "profileEffect": { "type": "string" },
        "profileFrame": { "type": "string" },
        "nameplate": { "type": "string" },
        "serverTag": { "type": "string" },
        "nitroTier": { "type": "string", "enum": ["none", "basic", "nitro"] },
        "displayNameStyle": { "type": "string" },
        "displayNameColorPreset": { "type": "string" },
        "displayNameCustomColors": { "type": "array", "items": { "type": "string" } },
        "displayNameGlow": { "type": "boolean" },
        "badgeIds": { "type": "array", "items": { "type": "string" } },
        "memberSince": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "username", "usernameLower", "avatar", "status", "memberSince", "updatedAt"]
    },
    "UsernameClaim": {
      "title": "UsernameClaim",
      "description": "Unique username reservation index mapping lowercase username to UID",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "username": { "type": "string" },
        "displayName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "username", "createdAt"]
    },
    "PrivateAccount": {
      "title": "PrivateAccount",
      "description": "Private user account state including Orbs balance, inventory, badges, and Nitro tier",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "orbs": { "type": "number" },
        "nitroTier": { "type": "string", "enum": ["none", "basic", "nitro"] },
        "ownedBundleIds": { "type": "array", "items": { "type": "string" } },
        "wishlistIds": { "type": "array", "items": { "type": "string" } },
        "unlockedBadgeIds": { "type": "array", "items": { "type": "string" } },
        "equippedBadgeIds": { "type": "array", "items": { "type": "string" } },
        "claimedQuestIds": { "type": "array", "items": { "type": "string" } },
        "boostsGiven": { "type": "integer" },
        "boostStreakMonths": { "type": "integer" },
        "giftsSent": { "type": "integer" },
        "streamHours": { "type": "integer" },
        "gamesPlayedCount": { "type": "integer" },
        "accountYears": { "type": "integer" },
        "joinedServerIds": { "type": "array", "items": { "type": "string" } },
        "isOwnerAccount": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "orbs", "nitroTier", "ownedBundleIds", "updatedAt"]
    },
    "UserNotification": {
      "title": "UserNotification",
      "description": "Per-user inbox notifications including /everyone mentions and DM replies",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "recipientUid": { "type": "string" },
        "senderUid": { "type": "string" },
        "type": { "type": "string", "enum": ["mention", "reply", "friend", "quest", "system"] },
        "title": { "type": "string" },
        "body": { "type": "string" },
        "timestamp": { "type": "string" },
        "unread": { "type": "boolean" },
        "avatar": { "type": "string" },
        "serverName": { "type": "string" },
        "targetDmId": { "type": "string" },
        "targetServerId": { "type": "string" },
        "targetChannelId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "recipientUid", "senderUid", "type", "title", "body", "unread", "avatar", "createdAt"]
    },
    "DirectMessage": {
      "title": "DirectMessage",
      "description": "Direct message thread between real users",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "participantIds": { "type": "array", "items": { "type": "string" } },
        "isGroup": { "type": "boolean" },
        "groupTitle": { "type": "string" },
        "groupEmoji": { "type": "string" },
        "groupColor": { "type": "string" },
        "participantProfiles": { "type": "object" },
        "lastMessagePreview": { "type": "string" },
        "lastTimestamp": { "type": "string" },
        "lastSenderId": { "type": "string" },
        "unreadBy": { "type": "array", "items": { "type": "string" } },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "participantIds", "lastMessagePreview", "updatedAt"]
    },
    "DirectMessageMessage": {
      "title": "DirectMessageMessage",
      "description": "Individual message inside a direct message thread",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "authorAvatar": { "type": "string" },
        "content": { "type": "string" },
        "timestamp": { "type": "string" },
        "createdAtMs": { "type": "integer" },
        "edited": { "type": "boolean" },
        "pinned": { "type": "boolean" },
        "threadCount": { "type": "integer" },
        "replyTo": { "type": "object" },
        "imageUrl": { "type": "string" },
        "sticker": { "type": "object" },
        "audioNote": { "type": "object" },
        "poll": { "type": "object" },
        "reactions": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "authorId", "authorName", "authorAvatar", "content", "createdAt"]
    },
    "Server": {
      "title": "Server",
      "description": "Community or friend server with strict ownerId and adminIds authorization",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "shortCode": { "type": "string" },
        "ownerId": { "type": "string" },
        "adminIds": { "type": "array", "items": { "type": "string" } },
        "iconStyle": { "type": "string" },
        "accentColor": { "type": "string" },
        "bannerColor": { "type": "string" },
        "bannerImage": { "type": "string" },
        "customIconUrl": { "type": "string" },
        "customEmoji": { "type": "string" },
        "description": { "type": "string" },
        "boostLevel": { "type": "integer" },
        "boostCount": { "type": "integer" },
        "unlockedPerkIds": { "type": "array", "items": { "type": "string" } },
        "activeServerTag": { "type": "string" },
        "categoriesOrder": { "type": "array", "items": { "type": "string" } },
        "roles": { "type": "array" },
        "customEmojis": { "type": "array" },
        "stickers": { "type": "array" },
        "chatTheme": { "type": "string" },
        "chatWallpaperUrl": { "type": "string" },
        "chatMessageStyle": { "type": "string" },
        "chatAccentColor": { "type": "string" },
        "showAllChannels": { "type": "boolean" },
        "communityEnabled": { "type": "boolean" },
        "isDiscoverable": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "shortCode", "ownerId", "adminIds", "accentColor", "bannerColor", "createdAt", "updatedAt"]
    },
    "ServerMember": {
      "title": "ServerMember",
      "description": "Membership record with server-scoped roles and admin permission flag",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "username": { "type": "string" },
        "avatar": { "type": "string" },
        "customAvatarUrl": { "type": "string" },
        "status": { "type": "string" },
        "roleIds": { "type": "array", "items": { "type": "string" } },
        "isAdmin": { "type": "boolean" },
        "joinedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "username", "avatar", "roleIds", "isAdmin", "joinedAt"]
    },
    "ServerChannel": {
      "title": "ServerChannel",
      "description": "Channel inside a server managed strictly by server owner or admins",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string", "enum": ["text", "voice", "announcement"] },
        "category": { "type": "string" },
        "isPrivate": { "type": "boolean" },
        "topic": { "type": "string" },
        "position": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "type", "category", "position", "createdAt"]
    },
    "ChannelMessage": {
      "title": "ChannelMessage",
      "description": "Message inside a server channel supporting /everyone mentions",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "authorAvatar": { "type": "string" },
        "authorTag": { "type": "string" },
        "content": { "type": "string" },
        "timestamp": { "type": "string" },
        "createdAtMs": { "type": "integer" },
        "edited": { "type": "boolean" },
        "pinned": { "type": "boolean" },
        "mentionEveryone": { "type": "boolean" },
        "threadCount": { "type": "integer" },
        "replyTo": { "type": "object" },
        "imageUrl": { "type": "string" },
        "sticker": { "type": "object" },
        "audioNote": { "type": "object" },
        "poll": { "type": "object" },
        "reactions": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "authorId", "authorName", "authorAvatar", "content", "createdAt"]
    },
    "ThreadMessage": {
      "title": "ThreadMessage",
      "description": "Reply inside a dedicated message thread",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "authorAvatar": { "type": "string" },
        "authorTag": { "type": "string" },
        "content": { "type": "string" },
        "timestamp": { "type": "string" },
        "createdAtMs": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "authorId", "authorName", "authorAvatar", "content", "createdAt"]
    },
    "FriendRequest": {
      "title": "FriendRequest",
      "description": "Incoming friend request awaiting acceptance or rejection",
      "type": "object",
      "properties": {
        "fromUid": { "type": "string" },
        "toUid": { "type": "string" },
        "fromDisplayName": { "type": "string" },
        "fromUsername": { "type": "string" },
        "fromAvatar": { "type": "string" },
        "fromCustomAvatarUrl": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "accepted", "declined"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["fromUid", "toUid", "fromDisplayName", "fromUsername", "fromAvatar", "status", "createdAt"]
    },
    "RtcCallSession": {
      "title": "RtcCallSession",
      "description": "WebRTC offer/answer and screen-share state for real-time DM audio/video/screen calls",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "callId": { "type": "string" },
        "callerUid": { "type": "string" },
        "callerName": { "type": "string" },
        "callerAvatar": { "type": "string" },
        "calleeUid": { "type": "string" },
        "status": { "type": "string", "enum": ["ringing", "connected", "ended"] },
        "active": { "type": "boolean" },
        "videoOn": { "type": "boolean" },
        "screenSharing": { "type": "boolean" },
        "callerVideoOn": { "type": "boolean" },
        "callerScreenSharing": { "type": "boolean" },
        "calleeVideoOn": { "type": "boolean" },
        "calleeScreenSharing": { "type": "boolean" },
        "offer": { "type": "object" },
        "answer": { "type": "object" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "callId", "callerUid", "status", "active", "updatedAt"]
    },
    "RtcIceCandidate": {
      "title": "RtcIceCandidate",
      "description": "ICE candidate for WebRTC peer connection signaling",
      "type": "object",
      "properties": {
        "callId": { "type": "string" },
        "uid": { "type": "string" },
        "candidate": { "type": "string" },
        "sdpMid": { "type": "string" },
        "sdpMLineIndex": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["callId", "uid", "candidate", "createdAt"]
    },
    "VoicePresence": {
      "title": "VoicePresence",
      "description": "Real-time voice channel participant presence and screen-share status",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "avatar": { "type": "string" },
        "customAvatarUrl": { "type": "string" },
        "muted": { "type": "boolean" },
        "videoOn": { "type": "boolean" },
        "screenSharing": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "avatar", "muted", "videoOn", "screenSharing", "updatedAt"]
    }
  },
  "firestore": {
    "/publicProfiles/{uid}": {
      "schema": { "$ref": "#/entities/PublicProfile" },
      "description": "Public searchable user profiles (no PII)"
    },
    "/usernames/{usernameLower}": {
      "schema": { "$ref": "#/entities/UsernameClaim" },
      "description": "Unique username lookup table"
    },
    "/users/{uid}/private/account": {
      "schema": { "$ref": "#/entities/PrivateAccount" },
      "description": "Owner-only private account wallet, inventory, and badges"
    },
    "/users/{uid}/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/UserNotification" },
      "description": "Per-user inbox notifications"
    },
    "/users/{uid}/friendRequests/{fromUid}": {
      "schema": { "$ref": "#/entities/FriendRequest" },
      "description": "Incoming friend requests for a user"
    },
    "/dms/{dmId}": {
      "schema": { "$ref": "#/entities/DirectMessage" },
      "description": "Direct message thread metadata"
    },
    "/dms/{dmId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/DirectMessageMessage" },
      "description": "Messages inside a direct message thread"
    },
    "/dms/{dmId}/messages/{messageId}/threads/{replyId}": {
      "schema": { "$ref": "#/entities/ThreadMessage" },
      "description": "Dedicated sub-chat replies inside a DM message thread"
    },
    "/servers/{serverId}": {
      "schema": { "$ref": "#/entities/Server" },
      "description": "Servers with strict ownerId and adminIds write enforcement"
    },
    "/servers/{serverId}/members/{memberUid}": {
      "schema": { "$ref": "#/entities/ServerMember" },
      "description": "Server members subcollection"
    },
    "/servers/{serverId}/channels/{channelId}": {
      "schema": { "$ref": "#/entities/ServerChannel" },
      "description": "Server channels subcollection"
    },
    "/servers/{serverId}/channels/{channelId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/ChannelMessage" },
      "description": "Server channel messages subcollection"
    },
    "/servers/{serverId}/channels/{channelId}/messages/{messageId}/threads/{replyId}": {
      "schema": { "$ref": "#/entities/ThreadMessage" },
      "description": "Dedicated sub-chat replies inside a channel message thread"
    },
    "/dms/{dmId}/rtc/{rtcDocId}": {
      "schema": { "$ref": "#/entities/RtcCallSession" },
      "description": "Active WebRTC call session and offer/answer signaling for a DM thread"
    },
    "/dms/{dmId}/rtc/{rtcDocId}/callerCandidates/{candId}": {
      "schema": { "$ref": "#/entities/RtcIceCandidate" },
      "description": "Caller ICE candidates for DM WebRTC signaling"
    },
    "/dms/{dmId}/rtc/{rtcDocId}/calleeCandidates/{candId}": {
      "schema": { "$ref": "#/entities/RtcIceCandidate" },
      "description": "Callee ICE candidates for DM WebRTC signaling"
    },
    "/servers/{serverId}/channels/{channelId}/rtc/{memberUid}": {
      "schema": { "$ref": "#/entities/VoicePresence" },
      "description": "Active voice channel participants and screen-share presence"
    }
  }
}
